// Weather Data Struct — shared type for weather information

export struct WeatherData {
    date: string,
    temperature: string,
    temp-min: string,
    temp-max: string,
    feels-like: string,
    pressure: string,
    wind-speed: string,
    wind-direction: string,
    humidity: string,
    condition: string,
    description: string,
    icon-code: string,
    precipitation: string,
    uv-index: string,
    visibility: string,
}
